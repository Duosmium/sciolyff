{
	"name": "sciolyff",
	"version": "0.20.0",
	"description": "A file format for Science Olympiad tournament results.",
	"license": "MIT",
	"author": "Duosmium Results (https://www.duosmium.org/results/)",
	"type": "module",
	"engines": {
		"node": "^22.0.0 || ^24.0.0 || ^26.0.0"
	},
	"files": [
		"dist/**/*"
	],
	"exports": {
		".": "./dist/src/index.js",
		"./interpreter": "./dist/src/interpreter/index.js",
		"./validator": "./dist/src/validator/index.js",
		"./convert": "./dist/src/convert/index.js"
	},
	"types": "./dist/src/index.d.ts",
	"bin": {
		"sciolyff-js": "./dist/bin/cli.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Duosmium/sciolyff-js.git"
	},
	"homepage": "https://github.com/Duosmium/sciolyff-js#readme",
	"bugs": {
		"url": "https://github.com/Duosmium/sciolyff-js/issues"
	},
	"scripts": {
		"clean": "rm -rf dist",
		"lint": "eslint .",
		"check": "tsc --noEmit",
		"format": "prettier --check .",
		"fix": "prettier --write . ; eslint --fix .",
		"build": "npm run clean && tsc",
		"build:tests": "tsc -p tsconfig.tests.json",
		"prepare": "husky",
		"release": "npm test; npm run build && release-it",
		"test": "npm run build:tests && c8 ava",
		"make-coverage": "c8 report -r lcovonly",
		"update-snapshots": "npm run build:tests && ava --update-snapshots"
	},
	"keywords": [
		"sciolyff",
		"scioly",
		"science olympiad",
		"duosmium"
	],
	"dependencies": {
		"@vanillaes/csv": "^4.1.3",
		"chalk": "^6.0.0",
		"commander": "^15.0.0",
		"fetch-retry": "^6.0.0",
		"js-yaml": "^4.3.1",
		"js-yaml-source-map": "^0.2.2",
		"node-fetch": "^3.3.2",
		"yup": "^1.7.1"
	},
	"devDependencies": {
		"@ava/typescript": "^7.0.0",
		"@eslint/js": "^10.0.1",
		"@types/js-yaml": "^4.0.9",
		"@types/node-fetch": "^2.6.13",
		"ava": "^8.0.1",
		"c8": "^12.0.0",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-ava": "^17.0.1",
		"globals": "^17.9.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "3.9.6",
		"release-it": "^21.0.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.67.0"
	},
	"lint-staged": {
		"*.{js,ts,json,yaml,yml,md}": "prettier --write",
		"*.{js,ts}": "eslint --cache --fix"
	},
	"ava": {
		"files": [
			"tests/**/test.ts"
		],
		"typescript": {
			"rewritePaths": {
				"tests/": "tests/dist/tests/"
			},
			"compile": false
		},
		"timeout": "3m"
	},
	"c8": {
		"src": [
			"./src/*"
		],
		"exclude": [
			"./src/interpreter/model.ts",
			"./src/interpreter/types.ts"
		],
		"all": true,
		"clean": true
	}
}
